# ============ LLM KEYS ============
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Default models (can override in code)
DEFAULT_MODEL=gpt-4o
FALLBACK_MODEL=claude-sonnet-4-5

# Embeddings
EMBEDDING_PROVIDER=openai  # openai|ollama
EMBEDDING_MODEL=text-embedding-3-small

# Ollama (Local LLM)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TASK_TYPES=["classification","summarize","parsing"]

# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_db
MONITORING_DATABASE_URL=sqlite:///./metrics.db
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# ============ SOCIAL PLATFORMS ============
# Facebook
FB_PAGE_TOKEN=your_page_access_token
FB_VERIFY_TOKEN=my_webhook_secret
FB_APP_SECRET=your_facebook_app_secret

# Zalo
ZALO_OA_TOKEN=your_oa_token
ZALO_SERVER_KEY=your_server_key

# Instagram (optional)
INSTA_BUSINESS_ACCOUNT_ID=your_account_id

# ============ SECURITY ============
API_SECRET_KEY=your-super-secret-key-change-this
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============ OBSERVABILITY ============
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-agent
LOG_LEVEL=INFO
PROMETHEUS_URL=http://localhost:9090

# ============ EMAIL ============
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DRAFTS_PATH=docs

# ============ SERVICE URLS ============
BROWSER_SERVICE_URL=http://browser:8003
COMPUTER_USE_SERVICE_URL=http://computer_use:8004
SOCIAL_SERVICE_URL=http://social:8002
RAG_SERVICE_URL=http://rag_service:8007
TOOL_SERVICE_URL=http://tool_service:8008
EMAIL_AGENT_SERVICE_URL=http://email_agent:8009
GUARDRAIL_SERVICE_URL=http://guardrail_service:8010
AGENT_HTTP_TIMEOUT_SECONDS=60

# ============ RAG ============
RAG_COLLECTION=rag_documents
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_DEFAULT_TOP_K=5
RAG_DOCS_PATH=docs

# ============ MONITORING & DASHBOARD ============
# Monitoring service URL (internal Docker: http://monitoring:8005, local: http://localhost:8005)
MONITORING_URL=http://localhost:8005
MONITORING_ENABLED=true
MONITORING_BATCH_SIZE=10
MONITORING_BATCH_TIMEOUT_MS=5000

# Dashboard settings
DASHBOARD_URL=http://localhost:8006
DASHBOARD_REFRESH_INTERVAL=60  # seconds

# ============ ENVIRONMENT ============
ENV=development
APP_NAME=Personal-AI-Agent
APP_VERSION=0.1.0
