# ============ LLM KEYS ============
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ---- OpenRouter (Reasoning Agent) ----
OPENROUTER_API_KEY=sk-or-v1-...

# Default models (can override in code)
REASONING_MODEL=google/gemini-2.0-flash-001
DEFAULT_MODEL=gpt-4o
FALLBACK_MODEL=claude-sonnet-4-5

# Embeddings
EMBEDDING_PROVIDER=openai  # openai|ollama
EMBEDDING_MODEL=text-embedding-3-small

# Ollama (Local LLM)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TASK_TYPES=["classification","summarize","parsing","draft","report_draft"]

# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_db
MONITORING_DATABASE_URL=sqlite:///./metrics.db
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=dev-redis-password-change-in-prod
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev-qdrant-key-change-in-prod
POSTGRES_PASSWORD=dev-postgres-password-change-in-prod

# ============ SOCIAL PLATFORMS ============
# Facebook
FB_PAGE_TOKEN=your_page_access_token
FB_VERIFY_TOKEN=my_webhook_secret
FB_APP_SECRET=your_facebook_app_secret

# Zalo
ZALO_OA_TOKEN=your_oa_token
ZALO_SERVER_KEY=your_server_key

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# Instagram (optional)
INSTA_BUSINESS_ACCOUNT_ID=your_account_id

# ============ SECURITY ============
API_SECRET_KEY=your-super-secret-key-change-this
INTERNAL_SERVICE_TOKEN=change-me-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============ OBSERVABILITY ============
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-agent
LOG_LEVEL=INFO
PROMETHEUS_URL=http://localhost:9090

# OpenTelemetry distributed tracing (PR 1)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-agent-automation
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_LOG_LEVEL=INFO

# ============ TOKEN BUDGET & COST CONTROL (PR 1) ============
MAX_TOKENS_PER_REQUEST=20000
MAX_TOKENS_PER_WORKFLOW=80000
MAX_LLM_CALLS_PER_WORKFLOW=20
MAX_COST_PER_WORKFLOW_USD=2.00
MAX_COST_PER_USER_DAILY_USD=10.00

# ============ EMAIL ============
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DRAFTS_PATH=docs

# ============ SERVICE URLS ============
BROWSER_SERVICE_URL=http://browser:8003
COMPUTER_USE_SERVICE_URL=http://computer_use:8004
SOCIAL_SERVICE_URL=http://social:8002
RAG_SERVICE_URL=http://rag_service:8007
TOOL_SERVICE_URL=http://tool_service:8008
EMAIL_AGENT_SERVICE_URL=http://email_agent:8009
GUARDRAIL_SERVICE_URL=http://guardrail_service:8010
MONITORING_SERVICE_URL=http://monitoring:8005
APPROVAL_SERVICE_URL=http://approval_service:8011
REPORT_AGENT_SERVICE_URL=http://report_agent:8012
AIOPS_AGENT_SERVICE_URL=http://aiops_agent:8013
RCA_AGENT_SERVICE_URL=http://rca_agent:8014
DEVOPS_AGENT_SERVICE_URL=http://devops_agent:8015
AGENTSCOPE_AGENT_SERVICE_URL=http://agentscope_agent:8017
AGENT_HTTP_TIMEOUT_SECONDS=60

# ============ RAG ============
RAG_COLLECTION=rag_documents
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_DEFAULT_TOP_K=5
RAG_DOCS_PATH=docs

# ============ ACCURACY & VERIFICATION ============
RAG_VERIFICATION_ENABLED=true
RAG_GRADING_THRESHOLD=0.7
RCA_MAX_REASONING_STEPS=5
ACCURACY_GUARDRAIL_ENABLED=true

# ============ MONITORING & DASHBOARD ============
# Monitoring service URL (internal Docker: http://monitoring:8005, local: http://localhost:8005)
MONITORING_URL=http://localhost:8005
MONITORING_ENABLED=true
MONITORING_BATCH_SIZE=10
MONITORING_BATCH_TIMEOUT_MS=5000

# Dashboard settings
DASHBOARD_URL=http://localhost:8006
DASHBOARD_REFRESH_INTERVAL=60  # seconds

# ============ ENVIRONMENT ============
ENV=development
APP_NAME=Personal-AI-Agent
APP_VERSION=0.1.0
SANDBOX_DEMO_MODE=false

# ============ OPTIONAL MCP INTEGRATIONS ============
# JSON object of opt-in STDIO MCP servers. Keep empty unless the matching
# commands are installed in the Gateway runtime.
MCP_ENABLED=true
MCP_SERVERS={}

# ============ OPTIONAL OPEN-SOURCE RUNTIME ADAPTERS ============
AGENTSCOPE_ENABLED=false
CLAW_ENABLED=false
CLAW_BINARY_PATH=
CLAW_WORKING_DIRECTORY=
CLAW_TIMEOUT_SECONDS=300
